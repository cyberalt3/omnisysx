# ============================================================
# OmnisysX — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git.
# ============================================================

# ─── LLM (OpenRouter) ──────────────────────────────────────
# Required. Powers the Task Manager, Auditor, and Orchestrator AI.
# Get one at https://openrouter.ai/keys
# Starts with "sk-or-v1-"
OPENROUTER_API_KEY=sk-or-v1-PASTE_HERE

# Optional: override the default model (Claude 3.5 Haiku — best cost/perf)
# LLM_MODEL=anthropic/claude-3.5-haiku


# ─── ZERION ─────────────────────────────────────────────────
# Required. Free key at https://developers.zerion.io
# Starts with "zk_"
ZERION_API_KEY=zk_PASTE_HERE

# Optional: pay-per-call instead of API key (x402 protocol on Base).
# Requires WALLET_PRIVATE_KEY of a wallet holding USDC on Base.
# Costs $0.01 USDC per analytics call.
# ZERION_X402=true


# ─── AGENT WALLET ──────────────────────────────────────────
# IMPORTANT: use a DEDICATED wallet for the agent, NOT your main wallet.
# Create one with:
#   zerion wallet create --name omnisysx-bot
#   zerion wallet fund            # then send a small amount of ETH + USDC
#
# The wallet name must match what you used in `zerion wallet create`:
AGENT_WALLET_NAME=omnisysx-bot

# The wallet's public address (0x...):
AGENT_WALLET_ADDRESS=0xPASTE_YOUR_AGENT_WALLET_HERE


# ─── SAFETY ────────────────────────────────────────────────
# Golden Rule: never let ETH balance fall below this amount.
# Default: 0.002 ETH (~4-5 cheap swaps worth of gas reserve).
MIN_ETH_GAS_RESERVE=0.002

# DRY_RUN: when true, the Executor logs the swap command but doesn't
# actually broadcast. Recommended: keep this `true` until you've tested
# the full pipeline at least once.
EXECUTOR_DRY_RUN=true


# ─── DISCORD BOT (only for bot/) ───────────────────────────
# Get these from https://discord.com/developers/applications
# 1. Create a New Application
# 2. Bot tab → Reset Token → copy here
# 3. Bot tab → Enable "Message Content Intent" (required for @mentions)
# 4. OAuth2 → General → Application ID → copy here
DISCORD_BOT_TOKEN=PASTE_HERE
DISCORD_CLIENT_ID=PASTE_HERE

# Optional: a channel ID where the bot will post automatic alerts.
# Enable Developer Mode in Discord, right-click a channel → Copy Channel ID.
# Leave empty to disable polling alerts.
ALERT_CHANNEL_ID=

# How often to poll watched wallets (in milliseconds). Default: 5 minutes.
POLL_INTERVAL_MS=300000
